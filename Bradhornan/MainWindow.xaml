<Window x:Class="Bradhornan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brädhörnan" Height="780" Width="1200" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen" Background="#F5F2EA"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}" Padding="22,15">
            <StackPanel>
                <TextBlock Text="BRÄDHÖRNAN" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Medlemmar, spelbibliotek och spelträffar" Foreground="#E8F0EA" FontSize="14" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="16" Background="White">
            <TabItem Header="Översikt">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Background="#EAF1EC" CornerRadius="6" Padding="18" Margin="5">
                            <StackPanel><TextBlock Text="Medlemmar" /><TextBlock x:Name="MemberCountText" FontSize="30" FontWeight="Bold" /></StackPanel>
                        </Border>
                        <Border Background="#FFF4DF" CornerRadius="6" Padding="18" Margin="5">
                            <StackPanel><TextBlock Text="Spel" /><TextBlock x:Name="GameCountText" FontSize="30" FontWeight="Bold" /></StackPanel>
                        </Border>
                        <Border Background="#EAF1EC" CornerRadius="6" Padding="18" Margin="5">
                            <StackPanel><TextBlock Text="Kommande träffar" /><TextBlock x:Name="EventCountText" FontSize="30" FontWeight="Bold" /></StackPanel>
                        </Border>
                        <Border Background="#FFF4DF" CornerRadius="6" Padding="18" Margin="5">
                            <StackPanel><TextBlock Text="Träffar med plats" /><TextBlock x:Name="AvailableEventCountText" FontSize="30" FontWeight="Bold" /></StackPanel>
                        </Border>
                    </UniformGrid>
                    <GroupBox Grid.Row="1" Header="Kommande spelträffar" Padding="10">
                        <DataGrid x:Name="UpcomingEventGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Namn" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Typ" Binding="{Binding EventType}" Width="2*" />
                                <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="150" />
                                <DataGridTextColumn Header="Plats" Binding="{Binding Location}" Width="*" />
                                <DataGridTextColumn Header="Anmälda" Binding="{Binding ParticipantCount}" Width="80" />
                                <DataGridTextColumn Header="Lediga" Binding="{Binding RemainingSeats}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Medlemmar">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBox x:Name="MemberSearchTextBox" Grid.Column="0" Margin="0,0,10,10"
                             TextChanged="MemberSearchTextBox_TextChanged" ToolTip="Sök på namn eller e-post" />
                    <DataGrid x:Name="MemberGrid" Grid.Row="1" Margin="0,0,10,0" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="MemberGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr" Binding="{Binding MemberNumber}" Width="65" />
                            <DataGridTextColumn Header="Namn" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80" />
                            <DataGridTextColumn Header="Medlem sedan" Binding="{Binding JoinedOn, StringFormat=yyyy-MM-dd}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="1" Grid.RowSpan="2" Header="Hantera medlem" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Namn" />
                            <TextBox x:Name="MemberNameTextBox" />
                            <TextBlock Text="E-post" Margin="4,8,4,0" />
                            <TextBox x:Name="MemberEmailTextBox" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Lägg till" Click="AddMemberButton_Click" />
                                <Button Content="Uppdatera" Click="UpdateMemberButton_Click" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Aktiv/inaktiv" Click="ToggleMemberButton_Click" />
                                <Button Content="Ta bort" Background="#9B3A3A" Click="DeleteMemberButton_Click" />
                            </WrapPanel>
                            <TextBlock Margin="4,18,4,0" TextWrapping="Wrap" Foreground="#555"
                                       Text="Tips: En medlem som redan är kopplad till en träff ska markeras som inaktiv i stället för att tas bort." />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Spelbibliotek">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,10">
                        <TextBox x:Name="GameSearchTextBox" Width="250" TextChanged="GameSearchTextBox_TextChanged" ToolTip="Sök på titel" />
                        <ComboBox x:Name="GameCategoryFilterComboBox" Width="170" SelectionChanged="GameCategoryFilterComboBox_SelectionChanged" />
                    </StackPanel>
                    <DataGrid x:Name="GameGrid" Grid.Row="1" Margin="0,0,10,0" IsReadOnly="True"
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="GameGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="110" />
                            <DataGridTextColumn Header="Spelare" Binding="{Binding PlayerRange}" Width="70" />
                            <DataGridTextColumn Header="Minuter" Binding="{Binding PlayTimeMinutes}" Width="70" />
                            <DataGridTextColumn Header="Svårighet" Binding="{Binding Difficulty}" Width="100" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Availability}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="GameGroupingText" Grid.Row="2" Margin="4,12,4,0" TextWrapping="Wrap" />
                    <GroupBox Grid.Column="1" Grid.RowSpan="3" Header="Hantera spel" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Titel" /><TextBox x:Name="GameTitleTextBox" />
                            <TextBlock Text="Kategori" Margin="4,6,4,0" /><ComboBox x:Name="GameCategoryComboBox" />
                            <UniformGrid Columns="2">
                                <StackPanel><TextBlock Text="Min spelare" Margin="4,6,4,0" /><TextBox x:Name="GameMinPlayersTextBox" /></StackPanel>
                                <StackPanel><TextBlock Text="Max spelare" Margin="4,6,4,0" /><TextBox x:Name="GameMaxPlayersTextBox" /></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Speltid i minuter" Margin="4,6,4,0" /><TextBox x:Name="GameMinutesTextBox" />
                            <TextBlock Text="Svårighetsgrad" Margin="4,6,4,0" /><ComboBox x:Name="GameDifficultyComboBox" />
                            <TextBlock Text="Beskrivning" Margin="4,6,4,0" />
                            <TextBox x:Name="GameDescriptionTextBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Lägg till" Click="AddGameButton_Click" />
                                <Button Content="Uppdatera" Click="UpdateGameButton_Click" />
                                <Button Content="Ta bort" Background="#9B3A3A" Click="DeleteGameButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Spelträffar">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="410" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="220" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DataGrid x:Name="EventGrid" Margin="0,0,10,10" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" SelectionChanged="EventGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Namn" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding EventType}" Width="*" />
                            <DataGridTextColumn Header="Datum" Binding="{Binding DateText}" Width="135" />
                            <DataGridTextColumn Header="Plats" Binding="{Binding Location}" Width="*" />
                            <DataGridTextColumn Header="Anmälda" Binding="{Binding ParticipantCount}" Width="70" />
                            <DataGridTextColumn Header="Lediga" Binding="{Binding RemainingSeats}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GroupBox Grid.Column="1" Grid.RowSpan="2" Header="Skapa spelträff" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Namn" /><TextBox x:Name="EventTitleTextBox" />
                                <TextBlock Text="Typ" Margin="4,5,4,0" /><ComboBox x:Name="EventTypeComboBox" SelectionChanged="EventTypeComboBox_SelectionChanged" />
                                <TextBlock x:Name="EventExtraLabel" Text="Tema/turneringsspel" Margin="4,5,4,0" />
                                <TextBox x:Name="EventExtraTextBox" />
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="Datum" Margin="4,5,4,0" /><DatePicker x:Name="EventDatePicker" /></StackPanel>
                                    <StackPanel><TextBlock Text="Tid (HH:mm)" Margin="4,5,4,0" /><TextBox x:Name="EventTimeTextBox" /></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Plats" Margin="4,5,4,0" /><TextBox x:Name="EventLocationTextBox" />
                                <TextBlock Text="Max deltagare" Margin="4,5,4,0" /><TextBox x:Name="EventCapacityTextBox" />
                                <TextBlock Text="Arrangör" Margin="4,5,4,0" /><ComboBox x:Name="EventOrganizerComboBox" DisplayMemberPath="Name" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Skapa träff" Click="AddEventButton_Click" />
                                    <Button Content="Ta bort träff" Background="#9B3A3A" Click="DeleteEventButton_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                    <Grid Grid.Row="1" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <GroupBox Header="Deltagare" Padding="10" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox x:Name="RegistrationMemberComboBox" DisplayMemberPath="Name" />
                                <ListBox x:Name="ParticipantListBox" Grid.Row="1" DisplayMemberPath="Name" Margin="4" />
                                <WrapPanel Grid.Row="2">
                                    <Button Content="Anmäl" Click="RegisterMemberButton_Click" />
                                    <Button Content="Avanmäl vald" Click="CancelRegistrationButton_Click" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Planerade och lämpliga spel" Padding="10" Margin="5,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox x:Name="PlanGameComboBox" DisplayMemberPath="Title" />
                                <ListBox x:Name="PlannedGamesListBox" Grid.Row="1" DisplayMemberPath="Title" Margin="4" />
                                <WrapPanel Grid.Row="2">
                                    <Button Content="Planera spel" Click="PlanGameButton_Click" />
                                    <Button Content="Ta bort valt" Click="RemovePlannedGameButton_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="SuitableGamesText" Grid.Row="3" Margin="4,8,4,0" TextWrapping="Wrap" Foreground="#555" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E7E2D8" Padding="12,7">
            <TextBlock x:Name="StatusTextBlock" Text="Redo" />
        </Border>
    </Grid>
</Window>
